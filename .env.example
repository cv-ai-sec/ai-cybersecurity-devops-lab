# Copy this file to .env and adjust values. .env is git-ignored — never commit it.
# All values below are dummy placeholders; none of them are real credentials.
#
# Intentionally generic. Every address is a placeholder, and setup-specific detail
# is kept out of this repository on purpose, to keep its attack surface low.
# See docs/SECURITY.md.

# --- Local LLM backend ---
# The model server's OpenAI-compatible API does not require a real key; this
# placeholder is only present because the OpenAI SDK requires a non-empty string.
# Use a local address only. The client refuses anything that is not local.
LM_STUDIO_BASE_URL=http://<host address>:<model port>/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=qwen2.5-7b-instruct

# Address of the machine that runs the model server, for services that need it.
HOST_LM_STUDIO_IP=<host address>

# --- Open-WebUI ---
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_SECRET_KEY=change-me-to-a-random-local-only-string

# --- Loki / Promtail ---
LOKI_PORT=3100

# --- Web dashboard ---
WEB_DASHBOARD_PORT=4321

# --- Vulnerability agent ---
TRIVY_SEVERITY=CRITICAL,HIGH
